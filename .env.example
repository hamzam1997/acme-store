# Acme Store configuration

PORT=5000
FLASK_DEBUG=1

# Payments provider (the only external service this repo calls)
PAYMENTS_API_KEY=
PAYMENTS_API_BASE=https://api.payments.example.com

# Customer messaging via notifications-service (@team-comms)
NOTIFICATIONS_API_KEY=
NOTIFICATIONS_SERVICE_BASE=https://notifications.example.com
DELAYED_REFUND_THRESHOLD_DAYS=3
DELAYED_REFUND_TEMPLATE_ID=delayed_refund_in_progress
